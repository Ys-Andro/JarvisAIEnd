{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile information",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Owner Google UID" },
        "displayName": { "type": "string", "description": "Display name of the user" },
        "email": { "type": "string", "description": "User email address" },
        "photoUrl": { "type": "string", "description": "Avatar photo URL" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Creation timestamp" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Last update timestamp" }
      },
      "required": ["userId", "displayName", "email", "createdAt"]
    },
    "TodoList": {
      "title": "TodoList",
      "description": "Shared to-do list container",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique list ID" },
        "title": { "type": "string", "description": "Title of the shared list" },
        "description": { "type": "string", "description": "Optional notes or details" },
        "ownerId": { "type": "string", "description": "UID of list creator" },
        "ownerEmail": { "type": "string", "description": "Email of list creator" },
        "memberUids": {
          "type": "array",
          "description": "List of user UIDs who have access to this list"
        },
        "colorHex": { "type": "string", "description": "Hex color code for visual theme" },
        "totalTasks": { "type": "integer", "description": "Total tasks count" },
        "completedTasks": { "type": "integer", "description": "Completed tasks count" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Creation timestamp" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Last update timestamp" }
      },
      "required": ["title", "ownerId", "ownerEmail", "memberUids", "createdAt"]
    },
    "TodoTask": {
      "title": "TodoTask",
      "description": "Individual task item within a shared list",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique task ID" },
        "listId": { "type": "string", "description": "Parent list ID" },
        "title": { "type": "string", "description": "Task description or title" },
        "description": { "type": "string", "description": "Extra details for the task" },
        "completed": { "type": "boolean", "description": "Whether the task is checked off" },
        "priority": { "type": "string", "enum": ["LOW", "MEDIUM", "HIGH"], "description": "Priority level" },
        "dueDate": { "type": "string", "description": "Optional due date formatted string" },
        "assignedToUid": { "type": "string", "description": "Optional assigned member UID" },
        "assignedToName": { "type": "string", "description": "Optional assigned member name" },
        "createdByUid": { "type": "string", "description": "UID of author" },
        "createdByName": { "type": "string", "description": "Name of author" },
        "memberUids": {
          "type": "array",
          "description": "Denormalized copy of parent list memberUids for fast subcollection rule validation"
        },
        "createdAt": { "type": "string", "format": "date-time", "description": "Creation timestamp" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Last update timestamp" }
      },
      "required": ["listId", "title", "completed", "priority", "createdByUid", "memberUids", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profile collection"
    },
    "/todo_lists/{listId}": {
      "schema": "TodoList",
      "description": "Shared to-do list collections accessible by members"
    },
    "/todo_lists/{listId}/tasks/{taskId}": {
      "schema": "TodoTask",
      "description": "Tasks subcollection for a given shared to-do list"
    }
  }
}
